pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 2048; }
http {
    map_hash_bucket_size 512;
    access_log off;
    server_tokens off;
    client_max_body_size 1m;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    map $http_authorization $evaluation_authorized {
        default 0;
        "~^Bearer ${DECISION_EVAL_API_KEY}$" 1;
    }
    limit_req_zone $binary_remote_addr zone=evaluation:1m rate=5000r/s;
    limit_req_status 429;
    server {
        listen ${EVAL_PUBLIC_PORT};
        if ($evaluation_authorized = 0) { return 401; }
        location / {
            limit_req zone=evaluation burst=256 nodelay;
            proxy_pass http://127.0.0.1:${EVAL_NATIVE_PORT};
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_connect_timeout 5s;
            proxy_read_timeout 310s;
        }
    }
}
